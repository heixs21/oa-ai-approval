# 复制成 .env 后填写真实值，.env 不要提交到版本库

# ---------- 泛微 OA ----------
OA_BASE_URL=http://10.0.0.10:8080
# 开放接口凭据（applytoken 请求头）
OA_APPID=
OA_SECRET=
# 下载 servlet 用的会话账号
OA_LOGINID=
OA_USERPASSWORD=
# 业务接口请求头里的 userid：以谁的身份调用，填用户主键（数字）
OA_USERID=
# 注册许可接口 /api/ec/dev/auth/regist 返回的 spk 公钥
# 泛微要求 userid 传 RSA 加密后的密文，这里填裸公钥串（不用加 BEGIN/END）
OA_SPK=
# userid 是否按明文传。实测要求密文，保持 false
OA_USERID_PLAIN=false

# token 有效期（秒），默认提前 5 分钟刷新
TOKEN_TTL=1500

# ---------- 处理范围 ----------
# 只处理这些流程，多个用逗号分隔；留空表示全部（不建议）
WORKFLOW_WHITELIST=
# 只处理这些节点，留空不限
NODE_WHITELIST=
# 附件字段的 fieldHtmlType，6=附件上传
ATTACH_HTML_TYPES=6

# ---------- AI ----------
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
# DeepSeek-V4.1-Flash，支持 PDF / Word / PPT / 图片文件输入
AI_MODEL=deepseek-flash
AI_TIMEOUT=180
# 实测只支持 text_recognition / rich_layout_recognition / user_data
FILE_PURPOSE=text_recognition
# 单文件上传上限（MB）
MAX_UPLOAD_MB=20
DELETE_FILE_AFTER_REVIEW=true

# ---------- 审批策略 ----------
# 低于这个置信度转人工（FORCE_APPROVE=true 时不生效）
CONFIDENCE_THRESHOLD=0.75
# 合同金额超过这个数转人工；0 表示不启用
AMOUNT_LIMIT=0
# 同一流程被人工退回达到这个次数就停止自动处理；0 表示不熔断
MAX_RETURN_COUNT=2
# true = 不看 AI 结论一律提交，只用它写的意见（AI 从"把关"变"代笔"）
FORCE_APPROVE=false
# 意见最大字数，0 = 不限制
MAX_REMARK_CHARS=0
# 提交时是否把换行转成 <br>（泛微按 HTML 渲染，\n 会被吞）
REMARK_HTML=true

# ---------- 运行 ----------
POLL_INTERVAL=60
MAX_RETRY=2
# true = 只生成意见写日志，不提交
DRY_RUN=true
